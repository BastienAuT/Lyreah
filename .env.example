# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Supabase Storage (server-side only)
# Create one private bucket named "lyreah".
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lyreah
SUPABASE_STORAGE_PREFIX=dev

# Supabase Storage (safe browser credentials used only with signed upload tokens)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=lyreah

# Production and monitoring
NEXT_PUBLIC_SITE_URL=https://example.com

# Public legal notices (required before opening registrations in production)
# Supported statuses: individual-non-professional or professional.
# In individual-non-professional mode, keep the private home address empty.
NEXT_PUBLIC_LEGAL_PUBLISHER_STATUS=individual-non-professional
NEXT_PUBLIC_LEGAL_PUBLISHER_NAME=
NEXT_PUBLIC_LEGAL_PUBLISHER_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
# Set to true only after the publisher's complete private identity has been
# communicated to the host. It replaces the public address requirement only
# for an individual publishing on a non-professional basis.
NEXT_PUBLIC_LEGAL_HOST_IDENTITY_CONFIRMED=false
# Values below assume the deployment described in vercel.json.
NEXT_PUBLIC_LEGAL_HOST_NAME=Vercel Inc.
NEXT_PUBLIC_LEGAL_HOST_ADDRESS="440 N Barranca Avenue #4133, Covina, CA 91723, États-Unis"
NEXT_PUBLIC_LEGAL_HOST_CONTACT=https://vercel.com/legal/privacy-notice

MONITORING_TOKEN=replace-with-a-long-random-token

# Staging E2E (GitHub variable/secrets; never target the production database)
E2E_BASE_URL=https://preview.example.com
E2E_VERCEL_PROTECTION_BYPASS=
E2E_SIGNUP_EMAIL=lyreah-recette+{timestamp}@example.com
E2E_SIGNUP_PASSWORD=
